rules_version = '2';

// 生活OS：パートナー共有の Firestore Security Rules（docs/PARTNER_NOTIFICATIONS_IMPLEMENTATION.md 4・5）
//
// - 共有するのは「生活グループ」の共有項目だけ。個人項目はアプリが送らず、ここにも置き場所が無い
// - 読めるのは、自分が所属する生活グループだけ
// - 共有項目の作成・更新は、そのグループのメンバーだけ。決まった項目・決まった種類だけを受け付ける
// - わが家（生活グループ）の作成・メンバーの追加は Callable Function（createHousehold・acceptInvite）だけが行う（ここでは拒否）。
//   1人1つのわが家・最大2人・招待の使用済み／取り消しは、Functions のトランザクションで守る（docs/FIREBASE_INVITE_JOIN_MEMBERSHIP.md）
// - 共有する種類（groups の sharedKinds）はアプリから変えられない
// - 役割（owner / member）の変更はできない（権限の昇格を拒否）
// - 共有項目（2026-10-28 Build 7）：新しく作れるのは ToDo・買い物だけ。わが家の設定でオンの種類だけ。
//   種類・作成者・作成日時・schemaVersion は変えられない（docs/SHARED_TODO_SHOPPING_FOUNDATION.md）
// - 退出・削除は leaveHousehold・deleteHousehold（サーバー）だけ。アプリからメンバー文書を消せない（2026-10-28）
// - 共有の支出（2026-11-01 Build 13）：groups/{groupID}/expenses/{expenseID}。メンバーだけが読み書きでき、
//   新しく作れるのは、わが家の設定で「家計簿」（money）がオンのときだけ。決まった項目だけ（レシート・メモ・予算は置けない）。
//   作成者・作成日時・schemaVersion は変えられない。オフにしたあとも、すでにある支出の変更・削除はできる
//   （docs/BUILD_13_SHARED_HOUSEHOLD_BUDGET_AND_EVENT_DELETE.md）
// - 共有の支出の商品明細（2026-11-08 Build 21）：groups/{groupID}/expenseLineItems/{expenseID}（支出1件に文書1つ）。
//   メンバーだけが読み書きでき、支出がある（または同じ書き込みで作る）ときだけ置ける。決まった2項目だけ・明細は最大50件・
//   1件ごとの形（明細ID・商品名1〜80文字・数量・単価・金額）を確かめる。共有の支出は、商品明細が残っているあいだは消せない
//   （明細だけが残らない）。docs/BUILD_21_RECEIPT_LINE_ITEM_HISTORY.md
// - わが家の月の予算（2026-11-10 Build 24）：groups/{groupID}/monthlyBudgets/{YYYY-MM}。メンバーだけが読み書きでき、
//   新しく作れるのは「家計簿」がオンのときだけ。決まった6項目・決まったカテゴリー・金額の範囲・カテゴリーの合計は月の予算以下。
//   自分だけの予算は置けない（アプリが送らない）。docs/BUILD_24_MONTHLY_BUDGET_AND_CATEGORY_SUMMARY.md
// - わが家で共有の定期支出（2026-11-11 Build 25）：設定は groups/{groupID}/recurringExpenses/{templateID}（決まった11項目）、
//   月ごとの状態は groups/{groupID}/recurringExpenseOccurrences/{templateID}_{YYYY-MM}（決まった7項目）。メンバーだけが読み書きできる。
//   「追加済み」は、新しい共有の支出と同じ書き込みでだけ作れて、変更・削除できない（同じ月の支出は1件だけ）。
//   「今月は追加しない」は消せる（未確認に戻す）。docs/BUILD_25_RECURRING_EXPENSES.md
// - 端末トークンは本人だけが登録・削除できる
// - 招待（invites）・通知の記録（notificationLog）はアプリから読み書きできない（Functions だけ）
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberPath(groupID, uid) {
      return /databases/$(database)/documents/groups/$(groupID)/members/$(uid);
    }

    function isMember(groupID) {
      return signedIn() && exists(memberPath(groupID, request.auth.uid));
    }

    function isNullOrTimestamp(value) {
      return value == null || value is timestamp;
    }

    function isShortText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    // MARK: - 利用者と端末

    match /users/{uid} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt', 'updatedAt', 'sharedMigrationCompletedAt'])
        && (!('displayName' in request.resource.data) || isShortText(request.resource.data.displayName, 40))
        && (!('sharedMigrationCompletedAt' in request.resource.data)
            || isNullOrTimestamp(request.resource.data.sharedMigrationCompletedAt));

      // 通知の宛先（端末ごと）。ドキュメント ID はアプリを入れるたびに作るランダムな ID（2026-10-28 Build 8。
      // 広告の識別子・端末固有の番号は使わない。docs/SHARED_PUSH_NOTIFICATIONS.md）
      match /devices/{deviceID} {
        allow read, delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && deviceID.matches('^[A-Za-z0-9_-]{1,128}$')
          && request.resource.data.keys().hasOnly([
            'fcmToken', 'platform', 'notificationsEnabled', 'sharedUpdatesEnabled', 'showsPreview', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll(['fcmToken', 'platform', 'notificationsEnabled', 'sharedUpdatesEnabled', 'updatedAt'])
          && isShortText(request.resource.data.fcmToken, 4096)
          // トークンは決まった文字だけ（空白・改行・記号の入った値を拒否。2026-10-28）
          && request.resource.data.fcmToken.matches('^[A-Za-z0-9:_-]+$')
          && request.resource.data.platform == 'ios'
          && request.resource.data.notificationsEnabled is bool
          && request.resource.data.sharedUpdatesEnabled is bool
          && (!('showsPreview' in request.resource.data) || request.resource.data.showsPreview is bool)
          && request.resource.data.updatedAt == request.time;
      }
    }

    // MARK: - 生活グループ

    match /groups/{groupID} {
      allow read: if isMember(groupID);

      // 作るのは createHousehold（サーバー）だけ。アプリからは作れない（1人1つ・共有する種類の確認をサーバーで行う）
      allow create: if false;

      // メンバーが変えられるのは名前と更新日時だけ
      allow update: if isMember(groupID)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
        && isShortText(request.resource.data.name, 50)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /members/{memberUID} {
        allow read: if isMember(groupID);

        // メンバーの追加は createHousehold・acceptInvite（サーバー）だけ。アプリからは誰も追加できない
        // （owner を名乗る・人数の上限を超える・別人の uid を書くことはできない）。
        // uid は文書 ID と同じ本人の UID（サーバーが書く。アカウント削除のあとの整理で所属を探すのに使う）
        allow create: if false;

        // 役割の変更（権限の昇格）・uid の変更は誰にもできない
        allow update: if false;

        // 退出・わが家の削除は leaveHousehold・deleteHousehold（サーバー）だけ（2026-10-28）。
        // オーナーの退出の禁止・所属の記録（memberships）の片付け・担当の解除をサーバーのトランザクションで行うため、
        // アプリからはメンバー文書を消せない（以前は本人なら消せた）
        allow delete: if false;
      }

      // 共有項目。2026-10-28（Build 7）から新しく作れるのは ToDo・買い物。
      // 2026-11-01（Build 14）から、カレンダーで「わが家で共有」を選んだ予定（event）も作れる（同じ場所・同じ形）
      match /items/{itemID} {
        function validItem(data) {
          return data.keys().hasOnly([
              'schemaVersion', 'title', 'kind', 'date', 'hasTime', 'assigneeUID', 'isCompleted',
              'deferredTo', 'droppedAt', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
            ])
            && data.keys().hasAll([
              'title', 'kind', 'date', 'hasTime', 'isCompleted', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
            ])
            && (!('schemaVersion' in data) || data.schemaVersion == 1)
            && isShortText(data.title, 200)
            && data.kind in ['event', 'todo', 'chore', 'shopping']
            && data.date is timestamp
            && data.hasTime is bool
            && data.isCompleted is bool
            && (!('assigneeUID' in data) || data.assigneeUID == null
                || (data.assigneeUID is string && exists(memberPath(groupID, data.assigneeUID))))
            && (!('deferredTo' in data) || isNullOrTimestamp(data.deferredTo))
            && (!('droppedAt' in data) || isNullOrTimestamp(data.droppedAt))
            && data.updatedBy == request.auth.uid
            && data.updatedAt == request.time;
        }

        // わが家の設定でオンになっている種類か（groups の sharedKinds。変えられるのは updateHousehold だけ）
        function kindIsEnabled(kind) {
          return kind in get(/databases/$(database)/documents/groups/$(groupID)).data.get('sharedKinds', []);
        }

        // 予定（Build 14）を作るときの決まり：完了なし・担当なし・あとで／もうやらないの印なし（カレンダーで作った形だけ）
        function validNewEvent(data) {
          return data.kind != 'event'
            || (data.isCompleted == false
              && data.get('assigneeUID', null) == null
              && data.get('deferredTo', null) == null
              && data.get('droppedAt', null) == null);
        }

        allow read: if isMember(groupID);

        // 作成：予定・ToDo・買い物だけ・設定でオンの種類だけ・schemaVersion 1・作成者は本人・作成日時はサーバーの時刻
        // （予定は Build 14 から。わが家の設定で「予定」がオンのときだけ）
        allow create: if isMember(groupID)
          && validItem(request.resource.data)
          && request.resource.data.kind in ['event', 'todo', 'shopping']
          && kindIsEnabled(request.resource.data.kind)
          && validNewEvent(request.resource.data)
          && request.resource.data.get('schemaVersion', 0) == 1
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;

        // 更新：種類・作成者・作成日時・schemaVersion は変えられない。
        // 種類をオフにしたあとも、すでにある共有項目の完了・編集・削除はできる（勝手に消さない。予定も同じ）
        allow update: if isMember(groupID)
          && validItem(request.resource.data)
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('schemaVersion', 0) == resource.data.get('schemaVersion', 0);

        allow delete: if isMember(groupID);
      }

      // 共有の支出（2026-11-01 Build 13）。共有 ToDo・買い物（items）とは別の場所・別の形
      match /expenses/{expenseID} {
        function validExpense(data) {
          return data.keys().hasOnly([
              'schemaVersion', 'title', 'amount', 'category', 'date', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
            ])
            && data.keys().hasAll([
              'schemaVersion', 'title', 'amount', 'category', 'date', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
            ])
            && data.schemaVersion == 1
            && isShortText(data.title, 200)
            && data.amount is int
            && data.amount > 0
            && data.amount <= 999999999
            && data.category in ['food', 'dailyGoods', 'diningOut', 'transport', 'subscription', 'other']
            && data.date is timestamp
            && data.createdBy is string
            && data.createdAt is timestamp
            && data.updatedBy == request.auth.uid
            && data.updatedAt == request.time;
        }

        // わが家の設定で「家計簿」がオンか（groups の sharedKinds。変えられるのは updateHousehold だけ）
        function moneyIsEnabled() {
          return 'money' in get(/databases/$(database)/documents/groups/$(groupID)).data.get('sharedKinds', []);
        }

        allow read: if isMember(groupID);

        // 作成：家計簿がオンのときだけ・文書の ID は支出の UUID・作成者は本人・作成日時はサーバーの時刻
        allow create: if isMember(groupID)
          && expenseID.matches('^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$')
          && validExpense(request.resource.data)
          && moneyIsEnabled()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;

        // 更新：作成者・作成日時・schemaVersion は変えられない。家計簿をオフにしたあとも変更できる（勝手に消さない）
        allow update: if isMember(groupID)
          && validExpense(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.schemaVersion == resource.data.schemaVersion;

        // 削除：メンバーなら（家計簿をオフにしたあとも）。
        // Build 21：商品明細（expenseLineItems）が残っているあいだは消せない。アプリは明細を先に（または同じ書き込みで）消す
        allow delete: if isMember(groupID)
          && !existsAfter(/databases/$(database)/documents/groups/$(groupID)/expenseLineItems/$(expenseID));
      }

      // 共有の支出の商品明細（2026-11-08 Build 21）。支出1件につき文書1つ（文書の ID は支出の UUID）。
      // rows の1件は「明細ID・商品名・数量・単価・金額」を区切り文字（制御文字）でつないだ文字列。並び順が表示順。
      // 1件ずつの形を正規表現で確かめる（ルールには繰り返しが無いため、50件分を並べて書く）
      match /expenseLineItems/{expenseID} {
        // 1件の形：明細ID（UUID）・商品名（制御文字を除く1〜80文字）・数量（空、または 0 より大きく 10000 未満・小数3桁まで）・
        // 単価（空、または 0〜999,999,999 の整数）・金額（0〜999,999,999 の整数）
        function lineItemRow(rows, index) {
          return rows.size() <= index
            || rows[index].matches('^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}[[:cntrl:]][^[:cntrl:]]{1,80}[[:cntrl:]]([1-9][0-9]{0,3}([.][0-9]{1,3})?|0[.][0-9]{0,2}[1-9])?[[:cntrl:]](0|[1-9][0-9]{0,8})?[[:cntrl:]](0|[1-9][0-9]{0,8})$');
        }

        function validLineItems(data) {
          return data.keys().hasOnly(['schemaVersion', 'rows'])
            && data.keys().hasAll(['schemaVersion', 'rows'])
            && data.schemaVersion == 1
            && data.rows is list
            && data.rows.size() >= 1
            && data.rows.size() <= 50
            && lineItemRow(data.rows, 0)
            && lineItemRow(data.rows, 1)
            && lineItemRow(data.rows, 2)
            && lineItemRow(data.rows, 3)
            && lineItemRow(data.rows, 4)
            && lineItemRow(data.rows, 5)
            && lineItemRow(data.rows, 6)
            && lineItemRow(data.rows, 7)
            && lineItemRow(data.rows, 8)
            && lineItemRow(data.rows, 9)
            && lineItemRow(data.rows, 10)
            && lineItemRow(data.rows, 11)
            && lineItemRow(data.rows, 12)
            && lineItemRow(data.rows, 13)
            && lineItemRow(data.rows, 14)
            && lineItemRow(data.rows, 15)
            && lineItemRow(data.rows, 16)
            && lineItemRow(data.rows, 17)
            && lineItemRow(data.rows, 18)
            && lineItemRow(data.rows, 19)
            && lineItemRow(data.rows, 20)
            && lineItemRow(data.rows, 21)
            && lineItemRow(data.rows, 22)
            && lineItemRow(data.rows, 23)
            && lineItemRow(data.rows, 24)
            && lineItemRow(data.rows, 25)
            && lineItemRow(data.rows, 26)
            && lineItemRow(data.rows, 27)
            && lineItemRow(data.rows, 28)
            && lineItemRow(data.rows, 29)
            && lineItemRow(data.rows, 30)
            && lineItemRow(data.rows, 31)
            && lineItemRow(data.rows, 32)
            && lineItemRow(data.rows, 33)
            && lineItemRow(data.rows, 34)
            && lineItemRow(data.rows, 35)
            && lineItemRow(data.rows, 36)
            && lineItemRow(data.rows, 37)
            && lineItemRow(data.rows, 38)
            && lineItemRow(data.rows, 39)
            && lineItemRow(data.rows, 40)
            && lineItemRow(data.rows, 41)
            && lineItemRow(data.rows, 42)
            && lineItemRow(data.rows, 43)
            && lineItemRow(data.rows, 44)
            && lineItemRow(data.rows, 45)
            && lineItemRow(data.rows, 46)
            && lineItemRow(data.rows, 47)
            && lineItemRow(data.rows, 48)
            && lineItemRow(data.rows, 49);
        }

        allow read: if isMember(groupID);

        // 作成・更新：メンバーだけ・文書の ID は支出の UUID・その支出がある（同じ書き込みで作る場合も含む）・決まった形だけ
        allow create, update: if isMember(groupID)
          && expenseID.matches('^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$')
          && existsAfter(/databases/$(database)/documents/groups/$(groupID)/expenses/$(expenseID))
          && validLineItems(request.resource.data);

        // 削除：メンバーなら（明細を全部消したとき・支出を消す前・自分だけへ変えるとき）
        allow delete: if isMember(groupID);
      }

      // notificationLog など、ここに書かれていない場所はすべて拒否（Functions は管理者として書く）

      // わが家で共有の定期支出の設定（2026-11-11 Build 25）。groups/{groupID}/recurringExpenses/{templateID}（文書の ID は設定の UUID）。
      // メンバーだけが読み書きでき（オーナーもパートナーも編集・停止・再開できる）、新しく作れるのは「家計簿」（money）がオンのときだけ
      // （オフにしたあとも、すでにある設定の変更はできる）。決まった11項目だけ。作成者・作成日時・schemaVersion は変えられない。
      // 全部を消すことはしない（Build 25 では停止だけ。わが家の削除のときはサーバーが消す）。docs/BUILD_25_RECURRING_EXPENSES.md
      match /recurringExpenses/{templateID} {
        function validRecurringTemplate(data) {
          return data.keys().hasOnly([
              'schemaVersion', 'title', 'expectedAmount', 'category', 'dueDay', 'startMonthKey', 'isActive',
              'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
            ])
            && data.keys().hasAll([
              'schemaVersion', 'title', 'expectedAmount', 'category', 'dueDay', 'startMonthKey', 'isActive',
              'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
            ])
            && data.schemaVersion == 1
            && data.title is string
            && data.title.matches('^[^[:cntrl:]]{1,80}$')
            && data.expectedAmount is int
            && data.expectedAmount >= 1
            && data.expectedAmount <= 999999999
            && data.category in ['food', 'dailyGoods', 'diningOut', 'transport', 'subscription', 'other']
            && data.dueDay is int
            && data.dueDay >= 1
            && data.dueDay <= 31
            && data.startMonthKey is string
            && data.startMonthKey.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
            && data.isActive is bool
            && data.createdBy is string
            && data.createdAt is timestamp
            && data.updatedBy == request.auth.uid
            && data.updatedAt == request.time;
        }

        // わが家の設定で「家計簿」がオンか（groups の sharedKinds。変えられるのは updateHousehold だけ）
        function recurringSharingIsOn() {
          return 'money' in get(/databases/$(database)/documents/groups/$(groupID)).data.get('sharedKinds', []);
        }

        allow read: if isMember(groupID);

        // 作成：メンバーだけ・家計簿がオンのときだけ・文書の ID は UUID・作成者は本人・作成日時はサーバーの時刻
        allow create: if isMember(groupID)
          && templateID.matches('^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$')
          && validRecurringTemplate(request.resource.data)
          && recurringSharingIsOn()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;

        // 更新（編集・停止・再開）：メンバーだけ。作成者・作成日時・schemaVersion は変えられない（家計簿をオフにしたあとも変えられる）
        allow update: if isMember(groupID)
          && validRecurringTemplate(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.schemaVersion == resource.data.schemaVersion;

        allow delete: if false;
      }

      // わが家で共有の定期支出の月ごとの状態（2026-11-11 Build 25）。
      // groups/{groupID}/recurringExpenseOccurrences/{templateID}_{YYYY-MM}（文書の ID は設定の ID と月のキー。同じ月は文書1つだけ）。
      // - created（追加済み）：新しい共有の支出（expenseID の文書）を、同じ書き込みで作るときだけ置ける。変更・削除できない
      //   （2台で同時に押しても、2回目は文書がすでにあるので断られ、支出も一緒に作られない）
      // - skipped（今月は追加しない）：支出は作らない（expenseID は null）。消せる（未確認に戻す）。変更はできない
      // - 処理した人は本人・処理した日時はサーバーの時刻。設定（recurringExpenses）がある月だけ
      match /recurringExpenseOccurrences/{occurrenceID} {
        function validOccurrence(data) {
          return data.keys().hasOnly(['schemaVersion', 'templateID', 'monthKey', 'status', 'expenseID', 'processedBy', 'processedAt'])
            && data.keys().hasAll(['schemaVersion', 'templateID', 'monthKey', 'status', 'expenseID', 'processedBy', 'processedAt'])
            && data.schemaVersion == 1
            && data.templateID is string
            && data.templateID.matches('^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$')
            && data.monthKey is string
            && data.monthKey.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
            && occurrenceID == data.templateID + '_' + data.monthKey
            && data.status in ['created', 'skipped']
            && data.processedBy == request.auth.uid
            && data.processedAt == request.time
            && exists(/databases/$(database)/documents/groups/$(groupID)/recurringExpenses/$(data.templateID));
        }

        function expensePath(expenseID) {
          return /databases/$(database)/documents/groups/$(groupID)/expenses/$(expenseID);
        }

        // 追加済み：expenseID は UUID で、その共有の支出は、この書き込みの前には無く、この書き込みのあとにある（同じ書き込みで作る）
        function createdWithNewExpense(data) {
          return data.status == 'created'
            && data.expenseID is string
            && data.expenseID.matches('^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$')
            && !exists(expensePath(data.expenseID))
            && existsAfter(expensePath(data.expenseID))
            && getAfter(expensePath(data.expenseID)).data.createdBy == request.auth.uid;
        }

        allow read: if isMember(groupID);

        allow create: if isMember(groupID)
          && validOccurrence(request.resource.data)
          && (createdWithNewExpense(request.resource.data)
            || (request.resource.data.status == 'skipped' && request.resource.data.expenseID == null));

        // 変更はできない（追加済みを「今月は追加しない」に変える・別の支出につけかえる、をさせない）
        allow update: if false;

        // 削除：「今月は追加しない」だけ（未確認に戻す）。追加済みは消せない（同じ月の支出を二重に作らない）
        allow delete: if isMember(groupID)
          && resource.data.status == 'skipped';
      }

      // わが家の月の予算（2026-11-10 Build 24）。groups/{groupID}/monthlyBudgets/{YYYY-MM}（月ごとに文書1つ。文書の ID は月のキー）。
      // メンバーだけが読み書きでき（オーナーもパートナーも変えられる）、新しく作れるのは、わが家の設定で「家計簿」（money）がオンのときだけ
      // （オフにしたあとも、すでにある予算の変更・解除はできる。共有の支出と同じ）。決まった6項目だけ・決まったカテゴリーだけ・
      // 金額は整数（月の予算 1〜999,999,999、カテゴリー 0〜999,999,999）・カテゴリーの合計は月の予算以下・
      // 変えた人は本人・変えた日時はサーバーの時刻。自分だけの予算はアプリが送らない（ここに置き場所は無い）。
      // docs/BUILD_24_MONTHLY_BUDGET_AND_CATEGORY_SUMMARY.md
      match /monthlyBudgets/{monthKey} {
        function validCategoryAmount(amounts, category) {
          return !(category in amounts)
            || (amounts[category] is int && amounts[category] >= 0 && amounts[category] <= 999999999);
        }

        function validMonthlyBudget(data) {
          return data.keys().hasOnly(['schemaVersion', 'monthKey', 'totalAmount', 'categoryAmounts', 'updatedBy', 'updatedAt'])
            && data.keys().hasAll(['schemaVersion', 'monthKey', 'totalAmount', 'categoryAmounts', 'updatedBy', 'updatedAt'])
            && data.schemaVersion == 1
            && data.monthKey == monthKey
            && data.totalAmount is int
            && data.totalAmount >= 1
            && data.totalAmount <= 999999999
            && data.categoryAmounts is map
            && data.categoryAmounts.keys().hasOnly(['food', 'dailyGoods', 'diningOut', 'transport', 'subscription', 'other'])
            && validCategoryAmount(data.categoryAmounts, 'food')
            && validCategoryAmount(data.categoryAmounts, 'dailyGoods')
            && validCategoryAmount(data.categoryAmounts, 'diningOut')
            && validCategoryAmount(data.categoryAmounts, 'transport')
            && validCategoryAmount(data.categoryAmounts, 'subscription')
            && validCategoryAmount(data.categoryAmounts, 'other')
            && data.categoryAmounts.get('food', 0) + data.categoryAmounts.get('dailyGoods', 0) + data.categoryAmounts.get('diningOut', 0)
              + data.categoryAmounts.get('transport', 0) + data.categoryAmounts.get('subscription', 0) + data.categoryAmounts.get('other', 0)
              <= data.totalAmount
            && data.updatedBy == request.auth.uid
            && data.updatedAt == request.time;
        }

        // 月のキーの形（2000年1月〜2099年12月）
        function validMonthKey() {
          return monthKey.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$');
        }

        // わが家の設定で「家計簿」がオンか（groups の sharedKinds。変えられるのは updateHousehold だけ）
        function budgetSharingIsOn() {
          return 'money' in get(/databases/$(database)/documents/groups/$(groupID)).data.get('sharedKinds', []);
        }

        allow read: if isMember(groupID);

        // 作成：メンバーだけ・家計簿がオンのときだけ・決まった形だけ
        allow create: if isMember(groupID)
          && validMonthKey()
          && validMonthlyBudget(request.resource.data)
          && budgetSharingIsOn();

        // 更新：メンバーだけ・決まった形だけ（家計簿をオフにしたあとも変えられる）
        allow update: if isMember(groupID)
          && validMonthKey()
          && validMonthlyBudget(request.resource.data);

        // 削除（予算の解除）：メンバーなら（家計簿をオフにしたあとも）
        allow delete: if isMember(groupID);
      }
    }

    // accountDeletions（アカウント削除の整理の作業記録）・memberships（1人1つのわが家の記録）など、
    // ここに書かれていない場所はすべて拒否（サーバーだけが読み書きする）

    // 招待：アプリからは読み書きできない（createInvite / acceptInvite だけが扱う）
    match /invites/{tokenHash} {
      allow read, write: if false;
    }
  }
}
